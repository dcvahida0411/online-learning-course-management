DJANGO_SECRET_KEY=replace-with-a-secure-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL is required for the final Project 2 database.
DB_ENGINE=postgresql
POSTGRES_DB=learnspace
POSTGRES_USER=learnspace
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# SMTP welcome emails. Keep the real password only in backend/.env.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-smtp-app-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=LearnSpace <your-email@example.com>
